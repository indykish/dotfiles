#!/usr/bin/env bash
set -euo pipefail

AGENTSFLEET_ENV="${HOME}/.config/agentsfleet/.env"
E2E_ENV="${HOME}/.config/e2e/.env"
UI_LOCAL_ENV="${HOME}/.config/agentsfleet/ui.env.local"
RUNNER_LOCAL_ENV="${HOME}/.config/agentsfleet/runner.env.local"

ok()   { printf '\033[32m✔\033[0m %s\n' "$1"; }
warn() { printf '\033[33m⚠\033[0m %s\n' "$1"; }

usage() {
  cat <<'EOF'
provision-env-1password — create local environment files from 1Password vaults.

Usage: provision-env-1password [--doctor]

Writes:
  ~/.config/agentsfleet/.env
  ~/.config/e2e/.env
  ~/.config/agentsfleet/ui.env.local      (dotenv format — Next.js app)
  ~/.config/agentsfleet/runner.env.local  (dotenv format — agentsfleet-runner)

The two *.env.local files are the machine-level sources that the agentsfleet
repo's .githooks/post-checkout symlinks into every worktree
(ui/packages/app/.env.local and .env.runner.local).

Requires OP_SERVICE_ACCOUNT_TOKEN, sourced from ~/.config/agentsfleet/.env when
it already exists. Prompts before overwriting files.
--doctor verifies file existence, mode 600, and required variable names only.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --doctor) DOCTOR_ONLY=1 ;;
  *) DOCTOR_ONLY=0 ;;
esac

AGENTSFLEET_VARS=(
  OP_SERVICE_ACCOUNT_TOKEN
  GITHUB_PERSONAL_ACCESS_TOKEN
  OPENROUTER_API_KEY
  FIREWORKS_API_KEY
  OLLAMA_CLOUD_API_KEY
  MOONSHOT_API_KEY
  PIONEER_API_KEY
  ZAI_API_TOKEN
)

E2E_VARS=(
  GITLAB_PERSONAL_ACCESS_TOKEN
  DOCKER_USER_INFRA
  DOCKER_PASSWORD_INFRA
  DOCKER_USER_MARKETPLACE
  DOCKER_PASSWORD_MARKETPLACE
  DOCKER_USER_MYACCOUNT
  DOCKER_PASSWORD_MYACCOUNT
)

UI_LOCAL_VARS=(
  NEXT_PUBLIC_API_URL
  NEXT_PUBLIC_POSTHOG_ENABLED
  NEXT_PUBLIC_POSTHOG_HOST
  NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
  CLERK_SECRET_KEY
)

# Canonical names per src/runner/daemon/config.zig and the runner_onboarding
# playbook — the old ZOMBIE_* spellings are dead since the M92 rename.
RUNNER_LOCAL_VARS=(
  AGENTSFLEET_API_URL
  AGENTSFLEET_RUNNER_TOKEN
  RUNNER_HOST_ID
  RUNNER_SANDBOX_TIER
  RUNNER_NETWORK_POLICY
)

doctor_env_file() {
  local file="$1" label="$2" failed=0 var mode
  shift 2

  if [[ ! -f "$file" ]]; then
    echo "doctor: missing $label env file: $file" >&2
    return 1
  fi

  mode=$(stat -f '%Lp' "$file")
  if [[ "$mode" != "600" ]]; then
    echo "doctor: $label mode is $mode, expected 600" >&2
    failed=1
  else
    ok "doctor: $label mode 600"
  fi

  for var in "$@"; do
    if grep -Eq "^export ${var}=" "$file"; then
      ok "doctor: $label has $var"
    else
      warn "doctor: $label missing $var"
      failed=1
    fi
  done

  return "$failed"
}

# Same checks as doctor_env_file, but for dotenv format (`VAR=`, no `export`).
doctor_dotenv_file() {
  local file="$1" label="$2" failed=0 var mode
  shift 2

  if [[ ! -f "$file" ]]; then
    echo "doctor: missing $label env file: $file" >&2
    return 1
  fi

  mode=$(stat -f '%Lp' "$file")
  if [[ "$mode" != "600" ]]; then
    echo "doctor: $label mode is $mode, expected 600" >&2
    failed=1
  else
    ok "doctor: $label mode 600"
  fi

  for var in "$@"; do
    if grep -Eq "^${var}=" "$file"; then
      ok "doctor: $label has $var"
    else
      warn "doctor: $label missing $var"
      failed=1
    fi
  done

  return "$failed"
}

doctor_env() {
  local failed=0
  doctor_env_file "$AGENTSFLEET_ENV" agentsfleet "${AGENTSFLEET_VARS[@]}" || failed=1
  doctor_env_file "$E2E_ENV" e2e "${E2E_VARS[@]}" || failed=1
  doctor_dotenv_file "$UI_LOCAL_ENV" ui "${UI_LOCAL_VARS[@]}" || failed=1
  doctor_dotenv_file "$RUNNER_LOCAL_ENV" runner "${RUNNER_LOCAL_VARS[@]}" || failed=1
  return "$failed"
}

if [[ $DOCTOR_ONLY -eq 1 ]]; then
  doctor_env && ok "env doctor passed" || { echo "env doctor failed" >&2; exit 1; }
  exit 0
fi

op_get() { op item get "$1" --vault "$2" --fields "$3" --reveal 2>/dev/null || true; }

# Bootstrap
[[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && [[ -f "${AGENTSFLEET_ENV}" ]] && { set -a; source "${AGENTSFLEET_ENV}"; set +a; }
[[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]] && { echo "OP_SERVICE_ACCOUNT_TOKEN not set"; exit 1; }
export OP_SERVICE_ACCOUNT_TOKEN
saved_token="${OP_SERVICE_ACCOUNT_TOKEN}"

echo "provision-env-1password: overwrite ${AGENTSFLEET_ENV} and ${E2E_ENV} from 1Password?"
read -rp "[y/N] " confirm
[[ "${confirm}" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

# --- agentsfleet (vault: ZMB_LOCAL_ENV) ---
V=ZMB_LOCAL_ENV
mkdir -p "$(dirname "${AGENTSFLEET_ENV}")"
printf 'export OP_SERVICE_ACCOUNT_TOKEN=%q\n' "${saved_token}" > "${AGENTSFLEET_ENV}"
chmod 600 "${AGENTSFLEET_ENV}"

for pair in \
  "github-pat=GITHUB_PERSONAL_ACCESS_TOKEN" \
  "openrouter-api-key=OPENROUTER_API_KEY" \
  "fireworks-api-token=FIREWORKS_API_KEY" \
  "ollama-cloud-api-key=OLLAMA_CLOUD_API_KEY" \
  "moonshot-api-token=MOONSHOT_API_KEY" \
  "pioneer-api-token=PIONEER_API_KEY" \
  "glm-api-token=ZAI_API_TOKEN"; do
  item="${pair%%=*}"; var="${pair#*=}"
  val="$(op_get "${item}" "${V}" password)"; [[ -z "${val}" ]] && val="$(op_get "${item}" "${V}" credential)"
  [[ -n "${val}" ]] && { printf 'export %s=%q\n' "${var}" "${val}" >> "${AGENTSFLEET_ENV}"; ok "${var}"; } || warn "${var}"
done

# --- e2e (vault: E2E_WORK) ---
V=E2E_WORK
mkdir -p "$(dirname "${E2E_ENV}")"
: > "${E2E_ENV}"
chmod 600 "${E2E_ENV}"

# simple keys
for pair in \
  "gitlab-pat=GITLAB_PERSONAL_ACCESS_TOKEN"; do
  item="${pair%%=*}"; var="${pair#*=}"
  val="$(op_get "${item}" "${V}" password)"; [[ -z "${val}" ]] && val="$(op_get "${item}" "${V}" credential)"
  [[ -n "${val}" ]] && { printf 'export %s=%q\n' "${var}" "${val}" >> "${E2E_ENV}"; ok "${var}"; } || warn "${var}"
done

# docker registries (username + password from same item)
for pair in \
  "docker-registry-infra=INFRA" \
  "docker-registry-marketplace=MARKETPLACE" \
  "docker-registry-myaccount=MYACCOUNT"; do
  item="${pair%%=*}"; prefix="${pair#*=}"
  user="$(op_get "${item}" "${V}" username)"
  pass="$(op_get "${item}" "${V}" password)"
  if [[ -n "${user}" && -n "${pass}" ]]; then
    printf 'export DOCKER_USER_%s=%q\n' "${prefix}" "${user}" >> "${E2E_ENV}"
    printf 'export DOCKER_PASSWORD_%s=%q\n' "${prefix}" "${pass}" >> "${E2E_ENV}"
    ok "DOCKER_*_${prefix}"
  else
    warn "DOCKER_*_${prefix}"
  fi
done

# --- ui app env (vault: ZMB_LOCAL_ENV, item clerk-dev — same fields CI reads
# via op://$VAULT_DEV/clerk-dev/{publishable-key,secret-key}) ---
V=ZMB_LOCAL_ENV
{
  printf 'NEXT_PUBLIC_API_URL=%s\n' "https://api-dev.agentsfleet.net"
  printf 'NEXT_PUBLIC_POSTHOG_ENABLED=%s\n' "false"
  printf 'NEXT_PUBLIC_POSTHOG_HOST=%s\n' "https://us.i.posthog.com"
} > "${UI_LOCAL_ENV}"
chmod 600 "${UI_LOCAL_ENV}"
# NEXT_PUBLIC_* is Next's browser-exposure prefix; the unprefixed pair is what
# @clerk/testing's clerkSetup() reads, and it is a Node library that knows
# nothing of that convention. Same values, two consumers — emitting both is
# what makes `bun run test:e2e:acceptance` self-sufficient in a fresh worktree,
# which is the stated goal of ui/packages/app/tests/e2e/acceptance/fixtures/env-loader.ts.
for pair in \
  "publishable-key=NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY" \
  "publishable-key=CLERK_PUBLISHABLE_KEY" \
  "secret-key=CLERK_SECRET_KEY" \
  "webhook-secret=CLERK_WEBHOOK_SECRET"; do
  field="${pair%%=*}"; var="${pair#*=}"
  val="$(op_get clerk-dev "${V}" "${field}")"
  [[ -n "${val}" ]] && { printf '%s=%s\n' "${var}" "${val}" >> "${UI_LOCAL_ENV}"; ok "${var}"; } || warn "${var} (1Password item clerk-dev/${field} missing — keep or hand-fill ${UI_LOCAL_ENV})"
done

# --- runner env (vault: ZMB_LOCAL_ENV, item runner-token) ---
{
  printf 'AGENTSFLEET_API_URL=%s\n' "http://agentsfleetd:3000"
  printf 'RUNNER_HOST_ID=%s\n' "local-dev-runner"
  printf 'RUNNER_SANDBOX_TIER=%s\n' "dev_none"
  printf 'RUNNER_NETWORK_POLICY=%s\n' "deny_all"
} > "${RUNNER_LOCAL_ENV}"
chmod 600 "${RUNNER_LOCAL_ENV}"
val="$(op_get runner-token "${V}" password)"; [[ -z "${val}" ]] && val="$(op_get runner-token "${V}" credential)"
[[ -n "${val}" ]] && { printf 'AGENTSFLEET_RUNNER_TOKEN=%s\n' "${val}" >> "${RUNNER_LOCAL_ENV}"; ok "AGENTSFLEET_RUNNER_TOKEN"; } || warn "AGENTSFLEET_RUNNER_TOKEN (1Password item runner-token missing — hand-fill ${RUNNER_LOCAL_ENV})"

doctor_env && ok "Done. Restart shell or: source ~/.zshrc" || { echo "env doctor failed" >&2; exit 1; }
